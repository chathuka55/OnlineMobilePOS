<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="bill_invoice_half_a4"
              pageWidth="420"
              pageHeight="595"
              columnWidth="390"
              leftMargin="15"
              rightMargin="15"
              topMargin="15"
              bottomMargin="15"
              uuid="b2c3d4e5-f6a7-8901-bcde-f12345678901">

    <parameter name="BILL_NUMBER" class="java.lang.String"/>
    <parameter name="CUSTOMER_NAME" class="java.lang.String"/>
    <parameter name="CURRENCY" class="java.lang.String"/>
    <parameter name="SUBTOTAL" class="java.math.BigDecimal"/>
    <parameter name="TAX_TOTAL" class="java.math.BigDecimal"/>
    <parameter name="DISCOUNT_TOTAL" class="java.math.BigDecimal"/>
    <parameter name="GRAND_TOTAL" class="java.math.BigDecimal"/>
    <parameter name="BILLED_AT" class="java.lang.String"/>
    <parameter name="BUSINESS_NAME" class="java.lang.String"/>
    <parameter name="OUTLET_ADDRESS" class="java.lang.String"/>
    <parameter name="OUTLET_CONTACT" class="java.lang.String"/>
    <parameter name="LOGO_IMAGE" class="java.io.InputStream"/>
    <!-- "SIDE" (logo right of business details) or "CENTERED" (logo above, centered). -->
    <parameter name="LOGO_LAYOUT" class="java.lang.String"/>

    <field name="lineNumber" class="java.lang.Short"/>
    <field name="itemSku" class="java.lang.String"/>
    <field name="itemName" class="java.lang.String"/>
    <field name="quantity" class="java.math.BigDecimal"/>
    <field name="unitPrice" class="java.math.BigDecimal"/>
    <field name="netAmount" class="java.math.BigDecimal"/>

    <title>
        <band height="190">
            <!-- Logo, SIDE layout -->
            <image onErrorType="Blank">
                <reportElement x="335" y="0" width="55" height="55">
                    <printWhenExpression><![CDATA[$P{LOGO_IMAGE} != null && !"CENTERED".equals($P{LOGO_LAYOUT})]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{LOGO_IMAGE}]]></imageExpression>
            </image>
            <!-- Logo, CENTERED layout -->
            <image onErrorType="Blank">
                <reportElement x="167" y="0" width="55" height="55">
                    <printWhenExpression><![CDATA[$P{LOGO_IMAGE} != null && "CENTERED".equals($P{LOGO_LAYOUT})]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{LOGO_IMAGE}]]></imageExpression>
            </image>

            <!-- Business details, SIDE layout: left-aligned, logo reserves the right 70pt. -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="320" height="20">
                    <printWhenExpression><![CDATA[$P{LOGO_IMAGE} != null && !"CENTERED".equals($P{LOGO_LAYOUT})]]></printWhenExpression>
                </reportElement>
                <textElement><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{BUSINESS_NAME}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="20" width="320" height="14">
                    <printWhenExpression><![CDATA[$P{LOGO_IMAGE} != null && !"CENTERED".equals($P{LOGO_LAYOUT})]]></printWhenExpression>
                </reportElement>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{OUTLET_ADDRESS}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="34" width="320" height="14">
                    <printWhenExpression><![CDATA[$P{LOGO_IMAGE} != null && !"CENTERED".equals($P{LOGO_LAYOUT})]]></printWhenExpression>
                </reportElement>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{OUTLET_CONTACT}]]></textFieldExpression>
            </textField>

            <!-- Business details, CENTERED layout: centered, pushed below the logo. -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="61" width="390" height="20">
                    <printWhenExpression><![CDATA[$P{LOGO_IMAGE} != null && "CENTERED".equals($P{LOGO_LAYOUT})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{BUSINESS_NAME}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="81" width="390" height="14">
                    <printWhenExpression><![CDATA[$P{LOGO_IMAGE} != null && "CENTERED".equals($P{LOGO_LAYOUT})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{OUTLET_ADDRESS}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="95" width="390" height="14">
                    <printWhenExpression><![CDATA[$P{LOGO_IMAGE} != null && "CENTERED".equals($P{LOGO_LAYOUT})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{OUTLET_CONTACT}]]></textFieldExpression>
            </textField>

            <!-- Business details, no logo: centered, starts at the top. -->
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="390" height="20">
                    <printWhenExpression><![CDATA[$P{LOGO_IMAGE} == null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{BUSINESS_NAME}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="20" width="390" height="14">
                    <printWhenExpression><![CDATA[$P{LOGO_IMAGE} == null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{OUTLET_ADDRESS}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="34" width="390" height="14">
                    <printWhenExpression><![CDATA[$P{LOGO_IMAGE} == null]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{OUTLET_CONTACT}]]></textFieldExpression>
            </textField>

            <!-- Invoice meta: same position regardless of logo layout. -->
            <staticText>
                <reportElement x="0" y="115" width="390" height="18"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[TAX INVOICE]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="135" width="390" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Bill: " + $P{BILL_NUMBER}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="151" width="390" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Customer: " + $P{CUSTOMER_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="167" width="390" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA["Date: " + $P{BILLED_AT}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="18">
            <staticText>
                <reportElement x="0" y="0" width="25" height="16"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[#]]></text>
            </staticText>
            <staticText>
                <reportElement x="25" y="0" width="55" height="16"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[SKU]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="0" width="140" height="16"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Item]]></text>
            </staticText>
            <staticText>
                <reportElement x="220" y="0" width="40" height="16"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <staticText>
                <reportElement x="260" y="0" width="60" height="16"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Price]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="0" width="70" height="16"/>
                <textElement><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Amount]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="16">
            <textField>
                <reportElement x="0" y="0" width="25" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{lineNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="25" y="0" width="55" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{itemSku}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="80" y="0" width="140" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{itemName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="220" y="0" width="40" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="260" y="0" width="60" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="70" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{netAmount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="70">
            <textField>
                <reportElement x="180" y="6" width="210" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Subtotal (" + $P{CURRENCY} + "): " + $P{SUBTOTAL}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="180" y="21" width="210" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Discount: " + $P{DISCOUNT_TOTAL}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="180" y="36" width="210" height="14"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Tax: " + $P{TAX_TOTAL}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="180" y="51" width="210" height="16"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Grand Total: " + $P{GRAND_TOTAL}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
