# Copy to .env and adjust. Never commit .env.

# ---- Database ----
# Two roles by design: the owner runs Flyway migrations, the app role serves
# traffic. The app role must NOT own the tables or PostgreSQL Row-Level Security
# would be bypassed and tenants could read each other's data.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=possaas
DB_OWNER_USER=possaas
DB_OWNER_PASSWORD=possaas
DB_APP_USER=possaas_app
DB_APP_PASSWORD=possaas_app_pw

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Object storage (MinIO in dev) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=possaas
S3_ACCESS_KEY=possaas
S3_SECRET_KEY=possaas123
S3_PATH_STYLE=true

# ---- API ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=DEBUG

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWRvLW5vdC11c2UtaW4tcHJvZHVjdGlvbi0xMjM0NTY3ODkw
JWT_ISSUER=https://api.possaas.local
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,tauri://localhost

# ---- Subscription billing ----
# none | stripe | payhere
PAYMENT_GATEWAY=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# ---- Frontends ----
NEXT_PUBLIC_API_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080
PUBLIC_API_URL=https://api.example.com

# ---- Production ----
REDIS_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
BACKUP_RETENTION_DAYS=14
API_IMAGE=ghcr.io/your-org/possaas-api:latest
DASHBOARD_IMAGE=ghcr.io/your-org/possaas-dashboard:latest
